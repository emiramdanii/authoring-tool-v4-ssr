# MySQL tanpa password — format: mysql://USER:@HOST:PORT/DATABASE
# Jika MySQL di lokal (localhost) port default 3306, user root, tanpa password:
DATABASE_URL="mysql://root:@localhost:3306/mpi_authoring"

# Jika masih gagal autentikasi, coba tambahkan auth plugin:
# DATABASE_URL="mysql://root:@localhost:3306/mpi_authoring?auth_plugin=mysql_native_password"
